{
  "extends": "../tsconfig/vue.json",
  "compilerOptions": {
    "paths": {
      "@/components/*": ["./src/*"],
      "@/components": ["./src/index.ts"],
      "@/utils/*": ["../core/src/utils/*"],
      "@/utils": ["../core/src/utils/index.ts"],
      "@/types/*": ["../core/src/types/*"],
      "@/types": ["../core/src/types/index.ts"],
      "@/composables/*": ["../core/src/composables/*"],
      "@/composables": ["../core/src/composables/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "../core/src/types/**/*"]
}
