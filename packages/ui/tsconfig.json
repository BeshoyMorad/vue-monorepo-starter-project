{
  "extends": "../tsconfig/vue.json",
  "compilerOptions": {
    "paths": {
      "@workspace/core/*": ["../core/src/*"],
      "@workspace/core": ["../core/src/index.ts"],
      "@workspace/ui/*": ["./src/*"],
      "@workspace/ui": ["./src/index.ts"],
      "@workspace/locales/*": ["../locales/src/*"],
      "@workspace/locales": ["../locales/src/index.ts"],
      "@/components/*": ["./src/*"],
      "@/components": ["./src/index.ts"],
      "@/utils/*": ["./src/utils/*"],
      "@/utils": ["./src/utils/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "../core/src/types/**/*"]
}
