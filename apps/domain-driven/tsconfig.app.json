{
  "extends": "../../packages/tsconfig/vue.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "paths": {
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/ui": ["../../packages/ui/src/index.ts"],
      "@workspace/core/*": ["../../packages/core/src/*"],
      "@workspace/core": ["../../packages/core/src/index.ts"],
      "@workspace/locales/*": ["../../packages/locales/src/*"],
      "@workspace/locales": ["../../packages/locales/src/index.ts"],
      "@/*": ["./src/*"],
      "@/tests/*": ["./tests/*"],
      "@domains/*": ["./src/domains/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../../packages/core/src/types/**/*.d.ts"
  ]
}
