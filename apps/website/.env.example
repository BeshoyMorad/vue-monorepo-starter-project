# Backend API root (all endpoints in api/endpoints.ts are relative to this)
NUXT_PUBLIC_API_BASE_URL=https://api.ibbil.com/api/v1
NUXT_PUBLIC_APP_NAME=Ibbil
# Public site URL, used by i18n for SEO alternate/canonical links
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3000
# Dev only: true moves API calls from the server to the browser so they show in the Network tab
# NUXT_PUBLIC_DEBUG_CLIENT_FETCH=true
